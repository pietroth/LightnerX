[
  {
    "label": "Run LightnerX (Server)",
    "command": "cmake --build build && ./build/LightnerX --server",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Run LightnerX (Client)",
    "command": "cmake --build build && ./build/LightnerX --client",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Rebuild CMake",
    "command": "rm -rf build && cmake -B build -G Ninja && cmake --build build",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
